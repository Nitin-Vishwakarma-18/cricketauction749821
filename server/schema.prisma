datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlayerRole {
  BATSMAN
  BOWLER
  ALL_ROUNDER
  WICKETKEEPER
}

enum PlayerStatus {
  UPCOMING
  IN_AUCTION
  SOLD
  UNSOLD
}

enum ActionType {
  BID
  SOLD
  UNSOLD
  UNDO
}

model Team {
  id              String        @id @default(cuid())
  name            String        @unique
  shortName       String        @unique // e.g. CSK, MI, RCB
  primaryColor    String        // Hex color for stage spotlights
  secondaryColor  String?
  logoUrl         String?
  totalBudget     BigInt        // In INR (e.g. 1,000,000,000 for 100 Cr)
  remainingBudget BigInt        // Automatically deducted on sale
  maxSquadSize    Int           @default(25)
  maxOverseas     Int           @default(8)
  
  players         Player[]      @relation("TeamSquad")
  bids            Bid[]
  actions         AuctionLog[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([shortName])
}

model Player {
  id              String        @id @default(cuid())
  lotNumber       Int           @unique
  name            String
  role            PlayerRole
  country         String        @default("India")
  isOverseas      Boolean       @default(false)
  basePrice       BigInt        // In INR (e.g. 20,000,000 for 2 Cr)
  soldPrice       BigInt?       // Final hammer price
  status          PlayerStatus  @default(UPCOMING)
  photoUrl        String?
  
  // Performance Statistics (JSON for flexibility)
  stats           Json?         // { matches, runs, wickets, strikeRate, economy, best }
  specialty       String?

  // Relations
  soldToTeamId    String?
  soldToTeam      Team?         @relation("TeamSquad", fields: [soldToTeamId], references: [id])
  bids            Bid[]
  auctionLogs     AuctionLog[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, lotNumber])
}

model Bid {
  id          String    @id @default(cuid())
  playerId    String
  teamId      String
  amount      BigInt    // In INR
  timestamp   DateTime  @default(now())

  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([playerId, timestamp])
}

model AuctionLog {
  id                  String     @id @default(cuid())
  type                ActionType
  playerId            String
  teamId              String?
  amount              BigInt?
  previousTeamBudget  BigInt?    // Enables rollback/undo
  timestamp           DateTime   @default(now())

  player              Player     @relation(fields: [playerId], references: [id])
  team                Team?      @relation(fields: [teamId], references: [id])

  @@index([timestamp])
}
